NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Notifications push (rappel du soir) — voir README pour comment générer
# ces valeurs.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://your-site.vercel.app

# Clé service_role Supabase (Project Settings > API) : contourne les
# policies RLS, utilisée uniquement par la tâche planifiée côté serveur.
# Ne JAMAIS préfixer par NEXT_PUBLIC_ — elle ne doit jamais atteindre le
# navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Secret partagé avec Vercel Cron pour vérifier que les appels à la route
# /api/cron/evening-check viennent bien de Vercel.
CRON_SECRET=
